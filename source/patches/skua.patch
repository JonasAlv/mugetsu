+                            ("Home", true, true) => Some(TextControlCode::SelectLeftDocument),
+                            ("Home", true, false) => Some(TextControlCode::MoveLeftDocument),
+                            ("Home", false, true) => Some(TextControlCode::SelectLeftLine),
+                            ("Home", false, false) => Some(TextControlCode::MoveLeftLine),
+                            ("End", true, true) => Some(TextControlCode::SelectRightDocument),
