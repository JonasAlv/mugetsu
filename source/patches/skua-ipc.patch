+pub fn report_window_ready(window: &winit::window::Window) {
+    if !is_enabled() {
+        return;
+    }
+    #[cfg(target_os = "linux")]
+    {
+        use std::ffi::{c_int, c_long, c_ulong, c_void};
+        use winit::raw_window_handle::{
+            HasDisplayHandle, HasWindowHandle, RawDisplayHandle, RawWindowHandle,
+        };
+        #[link(name = "X11")]
+        unsafe extern "C" {
+            fn XSelectInput(display: *mut c_void, w: c_ulong, event_mask: c_long) -> c_int;
+            fn XFlush(display: *mut c_void) -> c_int;
+        }
+        if let Ok(handle) = window.window_handle() {
+            let xid = match handle.as_raw() {
+                RawWindowHandle::Xlib(h) => Some(h.window as u64),
+                RawWindowHandle::Xcb(h) => Some(u64::from(h.window.get())),
+                _ => None,
+            };
+            if let Some(xid) = xid {
+                if let Ok(display_handle) = window.display_handle()
+                    && let RawDisplayHandle::Xlib(d) = display_handle.as_raw()
+                    && let Some(display_ptr) = d.display
+                {
+                    // Strip KeyPressMask | KeyReleaseMask from the embedded winit window so X11
+                    // propagates KeyPress/KeyRelease events to the parent Avalonia window even when
+                    // the mouse pointer is inside the game area.
+                    const EVENT_MASK_NO_KEYS: c_long = (1 << 15) // ExposureMask
+                        | (1 << 17) // StructureNotifyMask
+                        | (1 << 16) // VisibilityChangeMask
+                        | (1 << 14) // KeymapStateMask
+                        | (1 << 2)  // ButtonPressMask
+                        | (1 << 3)  // ButtonReleaseMask
+                        | (1 << 6)  // PointerMotionMask
+                        | (1 << 22); // PropertyChangeMask
+                    unsafe {
+                        XSelectInput(display_ptr.as_ptr(), xid as c_ulong, EVENT_MASK_NO_KEYS);
+                        XFlush(display_ptr.as_ptr());
+                    }
+                }
+                send_json(&json!({
+                    "type": "ready",
+                    "xid": xid,
+                }));
+            }
+        }
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = window;
+}
+
+pub fn send_reply(id: u64, value: &ExternalValue) {
+    send_json(&json!({
+        "type": "reply",
+        "id": id,
+        "value": external_to_json(value),
+    }));
+}
+
+fn json_to_external(val: JsonValue) -> ExternalValue {
+    match val {
+        JsonValue::Null => ExternalValue::Null,
+        JsonValue::Bool(b) => ExternalValue::Bool(b),
+        JsonValue::Number(n) => ExternalValue::Number(n.as_f64().unwrap_or(0.0)),
+        JsonValue::String(s) => ExternalValue::String(s),
+        JsonValue::Array(arr) => {
+            ExternalValue::List(arr.into_iter().map(json_to_external).collect())
+        }
+        JsonValue::Object(map) => {
+            let mut tree = BTreeMap::new();
+            for (k, v) in map {
+                tree.insert(k, json_to_external(v));
+            }
+            ExternalValue::Object(tree)
+        }
+    }
+}
+
+fn external_to_json(val: &ExternalValue) -> JsonValue {
+    match val {
+        ExternalValue::Undefined | ExternalValue::Null => JsonValue::Null,
+        ExternalValue::Bool(b) => JsonValue::Bool(*b),
+        ExternalValue::Number(n) => serde_json::Number::from_f64(*n)
+            .map(JsonValue::Number)
+            .unwrap_or(JsonValue::Null),
+        ExternalValue::String(s) => JsonValue::String(s.clone()),
+        ExternalValue::List(list) => {
+            JsonValue::Array(list.iter().map(external_to_json).collect())
+        }
+        ExternalValue::Object(map) => {
+            let mut obj = serde_json::Map::new();
+            for (k, v) in map {
+                obj.insert(k.clone(), external_to_json(v));
+            }
+            JsonValue::Object(obj)
+        }
+    }
+}
