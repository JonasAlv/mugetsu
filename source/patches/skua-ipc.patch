diff --git a/desktop/src/skua_ipc.rs b/desktop/src/skua_ipc.rs
new file mode 100644
--- /dev/null
+++ b/desktop/src/skua_ipc.rs
@@ -0,0 +1,652 @@
+//! Skua IPC bridge and X11 window embedding for VibeSkua on Linux.
+
+use crate::custom_event::RuffleEvent;
+use ruffle_core::PlayerEvent;
+use ruffle_core::context::UpdateContext;
+use ruffle_core::events::{
+    KeyDescriptor, KeyLocation, LogicalKey, NamedKey, PhysicalKey, TextControlCode,
+};
+use ruffle_core::external::{ExternalInterfaceProvider, Value as ExternalValue};
+use serde_json::{Value as JsonValue, json};
+use std::collections::BTreeMap;
+use std::io::{BufRead, BufReader, Write};
+use std::sync::{Mutex, OnceLock};
+use url::Url;
+use winit::event_loop::EventLoopProxy;
+
+#[cfg(unix)]
+use std::os::unix::net::UnixStream;
+
+static IPC_WRITER: OnceLock<Mutex<Box<dyn Write + Send>>> = OnceLock::new();
+
+pub enum SkuaIpcCommand {
+    Call {
+        id: u64,
+        name: String,
+        args: Vec<ExternalValue>,
+    },
+    Resize {
+        width: u32,
+        height: u32,
+    },
+    Focus {
+        focused: bool,
+    },
+    ClearKeys,
+    Key {
+        down: bool,
+        physical: String,
+        logical: String,
+        ctrl: bool,
+        shift: bool,
+        alt: bool,
+    },
+    Text {
+        text: String,
+    },
+}
+
+pub fn is_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("MUGETSU_SKUA_SOCKET").is_some())
+}
+
+#[cfg(target_os = "linux")]
+pub fn parent_xid() -> Option<u32> {
+    std::env::var("MUGETSU_PARENT_XID")
+        .ok()
+        .and_then(|s| s.trim().parse::<u64>().ok())
+        .filter(|&id| id > 0)
+        .map(|id| id as u32)
+}
+
+fn send_json(val: &JsonValue) {
+    if let Some(writer_lock) = IPC_WRITER.get()
+        && let Ok(mut writer) = writer_lock.lock()
+    {
+        if let Ok(mut line) = serde_json::to_vec(val) {
+            line.push(b'\n');
+            let _ = writer.write_all(&line);
+            let _ = writer.flush();
+        }
+    }
+}
+
+pub fn notify_mouse_down() {
+    if is_enabled() {
+        send_json(&json!({
+            "type": "mouse_down",
+        }));
+    }
+}
+
+pub fn start(event_loop_proxy: EventLoopProxy<RuffleEvent>) {
+    let Ok(socket_path) = std::env::var("MUGETSU_SKUA_SOCKET") else {
+        return;
+    };
+
+    #[cfg(target_os = "linux")]
+    {
+        unsafe extern "C" {
+            fn prctl(
+                option: std::os::raw::c_int,
+                arg2: std::os::raw::c_ulong,
+                arg3: std::os::raw::c_ulong,
+                arg4: std::os::raw::c_ulong,
+                arg5: std::os::raw::c_ulong,
+            ) -> std::os::raw::c_int;
+        }
+        unsafe {
+            prctl(1, 9, 0, 0, 0);
+        }
+    }
+
+    #[cfg(unix)]
+    {
+        match UnixStream::connect(&socket_path) {
+            Ok(stream) => {
+                if let Ok(write_stream) = stream.try_clone() {
+                    let _ = IPC_WRITER.set(Mutex::new(Box::new(write_stream)));
+                }
+                std::thread::Builder::new()
+                    .name("skua-ipc-reader".to_string())
+                    .spawn(move || {
+                        let reader = BufReader::new(stream);
+                        for line in reader.lines() {
+                            let Ok(line) = line else {
+                                break;
+                            };
+                            if line.trim().is_empty() {
+                                continue;
+                            }
+                            let Ok(msg) = serde_json::from_str::<JsonValue>(&line) else {
+                                continue;
+                            };
+                            let cmd_type = msg.get("cmd").and_then(|v| v.as_str()).unwrap_or("");
+                            match cmd_type {
+                                "call" => {
+                                    let id = msg.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                                    let name = msg
+                                        .get("name")
+                                        .and_then(|v| v.as_str())
+                                        .unwrap_or("")
+                                        .to_string();
+                                    let args = msg
+                                        .get("args")
+                                        .and_then(|v| v.as_array())
+                                        .map(|arr| {
+                                            arr.iter()
+                                                .cloned()
+                                                .map(json_to_external)
+                                                .collect::<Vec<_>>()
+                                        })
+                                        .unwrap_or_default();
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Call { id, name, args },
+                                    ));
+                                }
+                                "resize" => {
+                                    let width =
+                                        msg.get("width").and_then(|v| v.as_u64()).unwrap_or(0)
+                                            as u32;
+                                    let height =
+                                        msg.get("height").and_then(|v| v.as_u64()).unwrap_or(0)
+                                            as u32;
+                                    if width > 0 && height > 0 {
+                                        let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                            SkuaIpcCommand::Resize { width, height },
+                                        ));
+                                    }
+                                }
+                                "focus" => {
+                                    let focused = msg
+                                        .get("focused")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(true);
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Focus { focused },
+                                    ));
+                                }
+                                "clear_keys" => {
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::ClearKeys,
+                                    ));
+                                }
+                                "key" => {
+                                    let down = msg
+                                        .get("down")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let physical = msg
+                                        .get("physical")
+                                        .and_then(|v| v.as_str())
+                                        .unwrap_or("")
+                                        .to_string();
+                                    let logical = msg
+                                        .get("logical")
+                                        .and_then(|v| v.as_str())
+                                        .unwrap_or("")
+                                        .to_string();
+                                    let ctrl = msg
+                                        .get("ctrl")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let shift = msg
+                                        .get("shift")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let alt = msg
+                                        .get("alt")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Key {
+                                            down,
+                                            physical,
+                                            logical,
+                                            ctrl,
+                                            shift,
+                                            alt,
+                                        },
+                                    ));
+                                }
+                                "text" => {
+                                    if let Some(text) = msg.get("text").and_then(|v| v.as_str()) {
+                                        let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                            SkuaIpcCommand::Text {
+                                                text: text.to_string(),
+                                            },
+                                        ));
+                                    }
+                                }
+                                "quit" => {
+                                    std::process::exit(0);
+                                }
+                                _ => {}
+                            }
+                        }
+                        std::process::exit(0);
+                    })
+                    .ok();
+            }
+            Err(err) => {
+                tracing::error!("Failed to connect to Skua IPC socket {socket_path}: {err}");
+            }
+        }
+    }
+}
+
+pub fn handle_key_event(
+    player: &mut crate::player::PlayerController,
+    down: bool,
+    physical: &str,
+    logical: &str,
+    ctrl: bool,
+    shift: bool,
+    alt: bool,
+) {
+    let mut phys_loc = parse_physical_key(physical);
+    if phys_loc.0 == PhysicalKey::Unknown {
+        phys_loc = parse_physical_key(logical);
+    }
+    let (physical_key, key_location) = phys_loc;
+    let logical_key = parse_logical_key(physical_key, logical, shift);
+    let key = KeyDescriptor {
+        physical_key,
+        logical_key,
+        key_location,
+    };
+
+    if down {
+        player.handle_event(PlayerEvent::KeyDown { key });
+        if let Some(code) = map_text_control(&logical_key, ctrl, shift) {
+            player.handle_event(PlayerEvent::TextControl { code });
+        } else if !ctrl
+            && !alt
+            && let LogicalKey::Character(codepoint) = logical_key
+            && !codepoint.is_control()
+        {
+            player.handle_event(PlayerEvent::TextInput { codepoint });
+        }
+    } else {
+        player.handle_event(PlayerEvent::KeyUp { key });
+    }
+}
+
+fn map_text_control(logical_key: &LogicalKey, ctrl: bool, shift: bool) -> Option<TextControlCode> {
+    match *logical_key {
+        LogicalKey::Named(NamedKey::Enter) => Some(TextControlCode::Enter),
+        LogicalKey::Character('a' | 'A') if ctrl => Some(TextControlCode::SelectAll),
+        LogicalKey::Character('c' | 'C') if ctrl => Some(TextControlCode::Copy),
+        LogicalKey::Character('v' | 'V') if ctrl => Some(TextControlCode::Paste),
+        LogicalKey::Character('x' | 'X') if ctrl => Some(TextControlCode::Cut),
+        LogicalKey::Named(NamedKey::Backspace) if ctrl => Some(TextControlCode::BackspaceWord),
+        LogicalKey::Named(NamedKey::Backspace) => Some(TextControlCode::Backspace),
+        LogicalKey::Named(NamedKey::Delete) if ctrl => Some(TextControlCode::DeleteWord),
+        LogicalKey::Named(NamedKey::Delete) => Some(TextControlCode::Delete),
+        LogicalKey::Named(NamedKey::ArrowLeft) if ctrl && shift => {
+            Some(TextControlCode::SelectLeftWord)
+        }
+        LogicalKey::Named(NamedKey::ArrowLeft) if ctrl => Some(TextControlCode::MoveLeftWord),
+        LogicalKey::Named(NamedKey::ArrowLeft) if shift => Some(TextControlCode::SelectLeft),
+        LogicalKey::Named(NamedKey::ArrowLeft) => Some(TextControlCode::MoveLeft),
+        LogicalKey::Named(NamedKey::ArrowRight) if ctrl && shift => {
+            Some(TextControlCode::SelectRightWord)
+        }
+        LogicalKey::Named(NamedKey::ArrowRight) if ctrl => Some(TextControlCode::MoveRightWord),
+        LogicalKey::Named(NamedKey::ArrowRight) if shift => Some(TextControlCode::SelectRight),
+        LogicalKey::Named(NamedKey::ArrowRight) => Some(TextControlCode::MoveRight),
+        LogicalKey::Named(NamedKey::Home) if ctrl && shift => {
+            Some(TextControlCode::SelectLeftDocument)
+        }
+        LogicalKey::Named(NamedKey::Home) if ctrl => Some(TextControlCode::MoveLeftDocument),
+        LogicalKey::Named(NamedKey::Home) if shift => Some(TextControlCode::SelectLeftLine),
+        LogicalKey::Named(NamedKey::Home) => Some(TextControlCode::MoveLeftLine),
+        LogicalKey::Named(NamedKey::End) if ctrl && shift => {
+            Some(TextControlCode::SelectRightDocument)
+        }
+        LogicalKey::Named(NamedKey::End) if ctrl => Some(TextControlCode::MoveRightDocument),
+        LogicalKey::Named(NamedKey::End) if shift => Some(TextControlCode::SelectRightLine),
+        LogicalKey::Named(NamedKey::End) => Some(TextControlCode::MoveRightLine),
+        _ => None,
+    }
+}
+
+fn parse_physical_key(s: &str) -> (PhysicalKey, KeyLocation) {
+    let key = match s {
+        "KeyA" | "A" => PhysicalKey::KeyA,
+        "KeyB" | "B" => PhysicalKey::KeyB,
+        "KeyC" | "C" => PhysicalKey::KeyC,
+        "KeyD" | "D" => PhysicalKey::KeyD,
+        "KeyE" | "E" => PhysicalKey::KeyE,
+        "KeyF" | "F" => PhysicalKey::KeyF,
+        "KeyG" | "G" => PhysicalKey::KeyG,
+        "KeyH" | "H" => PhysicalKey::KeyH,
+        "KeyI" | "I" => PhysicalKey::KeyI,
+        "KeyJ" | "J" => PhysicalKey::KeyJ,
+        "KeyK" | "K" => PhysicalKey::KeyK,
+        "KeyL" | "L" => PhysicalKey::KeyL,
+        "KeyM" | "M" => PhysicalKey::KeyM,
+        "KeyN" | "N" => PhysicalKey::KeyN,
+        "KeyO" | "O" => PhysicalKey::KeyO,
+        "KeyP" | "P" => PhysicalKey::KeyP,
+        "KeyQ" | "Q" => PhysicalKey::KeyQ,
+        "KeyR" | "R" => PhysicalKey::KeyR,
+        "KeyS" | "S" => PhysicalKey::KeyS,
+        "KeyT" | "T" => PhysicalKey::KeyT,
+        "KeyU" | "U" => PhysicalKey::KeyU,
+        "KeyV" | "V" => PhysicalKey::KeyV,
+        "KeyW" | "W" => PhysicalKey::KeyW,
+        "KeyX" | "X" => PhysicalKey::KeyX,
+        "KeyY" | "Y" => PhysicalKey::KeyY,
+        "KeyZ" | "Z" => PhysicalKey::KeyZ,
+        "Digit0" | "D0" => PhysicalKey::Digit0,
+        "Digit1" | "D1" => PhysicalKey::Digit1,
+        "Digit2" | "D2" => PhysicalKey::Digit2,
+        "Digit3" | "D3" => PhysicalKey::Digit3,
+        "Digit4" | "D4" => PhysicalKey::Digit4,
+        "Digit5" | "D5" => PhysicalKey::Digit5,
+        "Digit6" | "D6" => PhysicalKey::Digit6,
+        "Digit7" | "D7" => PhysicalKey::Digit7,
+        "Digit8" | "D8" => PhysicalKey::Digit8,
+        "Digit9" | "D9" => PhysicalKey::Digit9,
+        "NumPad0" | "Numpad0" => return (PhysicalKey::Numpad0, KeyLocation::Numpad),
+        "NumPad1" | "Numpad1" => return (PhysicalKey::Numpad1, KeyLocation::Numpad),
+        "NumPad2" | "Numpad2" => return (PhysicalKey::Numpad2, KeyLocation::Numpad),
+        "NumPad3" | "Numpad3" => return (PhysicalKey::Numpad3, KeyLocation::Numpad),
+        "NumPad4" | "Numpad4" => return (PhysicalKey::Numpad4, KeyLocation::Numpad),
+        "NumPad5" | "Numpad5" => return (PhysicalKey::Numpad5, KeyLocation::Numpad),
+        "NumPad6" | "Numpad6" => return (PhysicalKey::Numpad6, KeyLocation::Numpad),
+        "NumPad7" | "Numpad7" => return (PhysicalKey::Numpad7, KeyLocation::Numpad),
+        "NumPad8" | "Numpad8" => return (PhysicalKey::Numpad8, KeyLocation::Numpad),
+        "NumPad9" | "Numpad9" => return (PhysicalKey::Numpad9, KeyLocation::Numpad),
+        "NumPadAdd" | "NumpadAdd" | "Add" => return (PhysicalKey::NumpadAdd, KeyLocation::Numpad),
+        "NumPadSubtract" | "NumpadSubtract" | "Subtract" => {
+            return (PhysicalKey::NumpadSubtract, KeyLocation::Numpad)
+        }
+        "NumPadMultiply" | "NumpadMultiply" | "Multiply" => {
+            return (PhysicalKey::NumpadMultiply, KeyLocation::Numpad)
+        }
+        "NumPadDivide" | "NumpadDivide" | "Divide" => {
+            return (PhysicalKey::NumpadDivide, KeyLocation::Numpad)
+        }
+        "NumPadDecimal" | "NumpadDecimal" | "Decimal" => {
+            return (PhysicalKey::NumpadDecimal, KeyLocation::Numpad)
+        }
+        "NumPadEnter" | "NumpadEnter" => return (PhysicalKey::NumpadEnter, KeyLocation::Numpad),
+        "Enter" | "Return" => PhysicalKey::Enter,
+        "Backspace" | "Back" => PhysicalKey::Backspace,
+        "Tab" => PhysicalKey::Tab,
+        "Space" => PhysicalKey::Space,
+        "Escape" => PhysicalKey::Escape,
+        "Delete" => PhysicalKey::Delete,
+        "Insert" => PhysicalKey::Insert,
+        "Home" => PhysicalKey::Home,
+        "End" => PhysicalKey::End,
+        "PageUp" | "Prior" => PhysicalKey::PageUp,
+        "PageDown" | "Next" => PhysicalKey::PageDown,
+        "ArrowLeft" | "Left" => PhysicalKey::ArrowLeft,
+        "ArrowRight" | "Right" => PhysicalKey::ArrowRight,
+        "ArrowUp" | "Up" => PhysicalKey::ArrowUp,
+        "ArrowDown" | "Down" => PhysicalKey::ArrowDown,
+        "ShiftLeft" | "LeftShift" => return (PhysicalKey::ShiftLeft, KeyLocation::Left),
+        "ShiftRight" | "RightShift" => return (PhysicalKey::ShiftRight, KeyLocation::Right),
+        "ControlLeft" | "LeftCtrl" => return (PhysicalKey::ControlLeft, KeyLocation::Left),
+        "ControlRight" | "RightCtrl" => return (PhysicalKey::ControlRight, KeyLocation::Right),
+        "AltLeft" | "LeftAlt" => return (PhysicalKey::AltLeft, KeyLocation::Left),
+        "AltRight" | "RightAlt" => return (PhysicalKey::AltRight, KeyLocation::Right),
+        "SuperLeft" | "MetaLeft" | "LWin" => return (PhysicalKey::SuperLeft, KeyLocation::Left),
+        "SuperRight" | "MetaRight" | "RWin" => return (PhysicalKey::SuperRight, KeyLocation::Right),
+        "CapsLock" | "Capital" => PhysicalKey::CapsLock,
+        "NumLock" => PhysicalKey::NumLock,
+        "ScrollLock" | "Scroll" => PhysicalKey::ScrollLock,
+        "Minus" | "OemMinus" => PhysicalKey::Minus,
+        "Equal" | "OemPlus" => PhysicalKey::Equal,
+        "BracketLeft" | "OemOpenBrackets" => PhysicalKey::BracketLeft,
+        "BracketRight" | "OemCloseBrackets" => PhysicalKey::BracketRight,
+        "Backslash" | "OemPipe" => PhysicalKey::Backslash,
+        "IntlBackslash" | "OemBackslash" => PhysicalKey::IntlBackslash,
+        "Semicolon" | "OemSemicolon" => PhysicalKey::Semicolon,
+        "Quote" | "OemQuotes" => PhysicalKey::Quote,
+        "Backquote" | "OemTilde" => PhysicalKey::Backquote,
+        "Comma" | "OemComma" => PhysicalKey::Comma,
+        "Period" | "OemPeriod" => PhysicalKey::Period,
+        "Slash" | "OemQuestion" => PhysicalKey::Slash,
+        "F1" => PhysicalKey::F1,
+        "F2" => PhysicalKey::F2,
+        "F3" => PhysicalKey::F3,
+        "F4" => PhysicalKey::F4,
+        "F5" => PhysicalKey::F5,
+        "F6" => PhysicalKey::F6,
+        "F7" => PhysicalKey::F7,
+        "F8" => PhysicalKey::F8,
+        "F9" => PhysicalKey::F9,
+        "F10" => PhysicalKey::F10,
+        "F11" => PhysicalKey::F11,
+        "F12" => PhysicalKey::F12,
+        _ => PhysicalKey::Unknown,
+    };
+    (key, KeyLocation::Standard)
+}
+
+fn parse_logical_key(physical: PhysicalKey, logical: &str, shift: bool) -> LogicalKey {
+    match logical {
+        "Enter" | "Return" | "NumPadEnter" => LogicalKey::Named(NamedKey::Enter),
+        "Backspace" | "Back" => LogicalKey::Named(NamedKey::Backspace),
+        "Tab" => LogicalKey::Named(NamedKey::Tab),
+        "Space" => LogicalKey::Character(' '),
+        "Escape" => LogicalKey::Named(NamedKey::Escape),
+        "Delete" => LogicalKey::Named(NamedKey::Delete),
+        "Insert" => LogicalKey::Named(NamedKey::Insert),
+        "Home" => LogicalKey::Named(NamedKey::Home),
+        "End" => LogicalKey::Named(NamedKey::End),
+        "PageUp" | "Prior" => LogicalKey::Named(NamedKey::PageUp),
+        "PageDown" | "Next" => LogicalKey::Named(NamedKey::PageDown),
+        "ArrowLeft" | "Left" => LogicalKey::Named(NamedKey::ArrowLeft),
+        "ArrowRight" | "Right" => LogicalKey::Named(NamedKey::ArrowRight),
+        "ArrowUp" | "Up" => LogicalKey::Named(NamedKey::ArrowUp),
+        "ArrowDown" | "Down" => LogicalKey::Named(NamedKey::ArrowDown),
+        "ShiftLeft" | "ShiftRight" | "LeftShift" | "RightShift" => {
+            LogicalKey::Named(NamedKey::Shift)
+        }
+        "ControlLeft" | "ControlRight" | "LeftCtrl" | "RightCtrl" => {
+            LogicalKey::Named(NamedKey::Control)
+        }
+        "AltLeft" | "AltRight" | "LeftAlt" | "RightAlt" => LogicalKey::Named(NamedKey::Alt),
+        "CapsLock" | "Capital" => LogicalKey::Named(NamedKey::CapsLock),
+        "NumLock" => LogicalKey::Named(NamedKey::NumLock),
+        "ScrollLock" | "Scroll" => LogicalKey::Named(NamedKey::ScrollLock),
+        "F1" => LogicalKey::Named(NamedKey::F1),
+        "F2" => LogicalKey::Named(NamedKey::F2),
+        "F3" => LogicalKey::Named(NamedKey::F3),
+        "F4" => LogicalKey::Named(NamedKey::F4),
+        "F5" => LogicalKey::Named(NamedKey::F5),
+        "F6" => LogicalKey::Named(NamedKey::F6),
+        "F7" => LogicalKey::Named(NamedKey::F7),
+        "F8" => LogicalKey::Named(NamedKey::F8),
+        "F9" => LogicalKey::Named(NamedKey::F9),
+        "F10" => LogicalKey::Named(NamedKey::F10),
+        "F11" => LogicalKey::Named(NamedKey::F11),
+        "F12" => LogicalKey::Named(NamedKey::F12),
+        s if s.chars().count() == 1 => {
+            let ch = s.chars().next().unwrap_or(' ');
+            LogicalKey::Character(ch)
+        }
+        _ => {
+            let _ = shift;
+            match physical {
+            PhysicalKey::Digit0 | PhysicalKey::Numpad0 => LogicalKey::Character('0'),
+            PhysicalKey::Digit1 | PhysicalKey::Numpad1 => LogicalKey::Character('1'),
+            PhysicalKey::Digit2 | PhysicalKey::Numpad2 => LogicalKey::Character('2'),
+            PhysicalKey::Digit3 | PhysicalKey::Numpad3 => LogicalKey::Character('3'),
+            PhysicalKey::Digit4 | PhysicalKey::Numpad4 => LogicalKey::Character('4'),
+            PhysicalKey::Digit5 | PhysicalKey::Numpad5 => LogicalKey::Character('5'),
+            PhysicalKey::Digit6 | PhysicalKey::Numpad6 => LogicalKey::Character('6'),
+            PhysicalKey::Digit7 | PhysicalKey::Numpad7 => LogicalKey::Character('7'),
+            PhysicalKey::Digit8 | PhysicalKey::Numpad8 => LogicalKey::Character('8'),
+            PhysicalKey::Digit9 | PhysicalKey::Numpad9 => LogicalKey::Character('9'),
+            PhysicalKey::Space => LogicalKey::Character(' '),
+            PhysicalKey::Enter | PhysicalKey::NumpadEnter => LogicalKey::Named(NamedKey::Enter),
+            _ => LogicalKey::Unknown,
+        }
+        }
+    }
+}
