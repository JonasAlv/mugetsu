+fn parse_physical_key(s: &str) -> (PhysicalKey, KeyLocation) {
+    let key = match s {
+        "KeyA" | "A" => PhysicalKey::KeyA,
+        "KeyB" | "B" => PhysicalKey::KeyB,
+        "KeyC" | "C" => PhysicalKey::KeyC,
+        "KeyD" | "D" => PhysicalKey::KeyD,
+        "KeyE" | "E" => PhysicalKey::KeyE,
+        "KeyF" | "F" => PhysicalKey::KeyF,
+        "KeyG" | "G" => PhysicalKey::KeyG,
+        "KeyH" | "H" => PhysicalKey::KeyH,
+        "KeyI" | "I" => PhysicalKey::KeyI,
+        "KeyJ" | "J" => PhysicalKey::KeyJ,
+        "KeyK" | "K" => PhysicalKey::KeyK,
+        "KeyL" | "L" => PhysicalKey::KeyL,
+        "KeyM" | "M" => PhysicalKey::KeyM,
+        "KeyN" | "N" => PhysicalKey::KeyN,
+        "KeyO" | "O" => PhysicalKey::KeyO,
+        "KeyP" | "P" => PhysicalKey::KeyP,
+        "KeyQ" | "Q" => PhysicalKey::KeyQ,
+        "KeyR" | "R" => PhysicalKey::KeyR,
+        "KeyS" | "S" => PhysicalKey::KeyS,
+        "KeyT" | "T" => PhysicalKey::KeyT,
+        "KeyU" | "U" => PhysicalKey::KeyU,
+        "KeyV" | "V" => PhysicalKey::KeyV,
+        "KeyW" | "W" => PhysicalKey::KeyW,
+        "KeyX" | "X" => PhysicalKey::KeyX,
+        "KeyY" | "Y" => PhysicalKey::KeyY,
+        "KeyZ" | "Z" => PhysicalKey::KeyZ,
+        "Digit0" | "D0" => PhysicalKey::Digit0,
+        "Digit1" | "D1" => PhysicalKey::Digit1,
+        "Digit2" | "D2" => PhysicalKey::Digit2,
+        "Digit3" | "D3" => PhysicalKey::Digit3,
+        "Digit4" | "D4" => PhysicalKey::Digit4,
+        "Digit5" | "D5" => PhysicalKey::Digit5,
+        "Digit6" | "D6" => PhysicalKey::Digit6,
+        "Digit7" | "D7" => PhysicalKey::Digit7,
+        "Digit8" | "D8" => PhysicalKey::Digit8,
+        "Digit9" | "D9" => PhysicalKey::Digit9,
+        "NumPad0" | "Numpad0" => return (PhysicalKey::Numpad0, KeyLocation::Numpad),
+        "NumPad1" | "Numpad1" => return (PhysicalKey::Numpad1, KeyLocation::Numpad),
+        "NumPad2" | "Numpad2" => return (PhysicalKey::Numpad2, KeyLocation::Numpad),
+        "NumPad3" | "Numpad3" => return (PhysicalKey::Numpad3, KeyLocation::Numpad),
+        "NumPad4" | "Numpad4" => return (PhysicalKey::Numpad4, KeyLocation::Numpad),
+        "NumPad5" | "Numpad5" => return (PhysicalKey::Numpad5, KeyLocation::Numpad),
+        "NumPad6" | "Numpad6" => return (PhysicalKey::Numpad6, KeyLocation::Numpad),
+        "NumPad7" | "Numpad7" => return (PhysicalKey::Numpad7, KeyLocation::Numpad),
+        "NumPad8" | "Numpad8" => return (PhysicalKey::Numpad8, KeyLocation::Numpad),
+        "NumPad9" | "Numpad9" => return (PhysicalKey::Numpad9, KeyLocation::Numpad),
+        "NumPadAdd" | "NumpadAdd" | "Add" => return (PhysicalKey::NumpadAdd, KeyLocation::Numpad),
+        "NumPadSubtract" | "NumpadSubtract" | "Subtract" => {
+            return (PhysicalKey::NumpadSubtract, KeyLocation::Numpad)
+        }
+        "NumPadMultiply" | "NumpadMultiply" | "Multiply" => {
+            return (PhysicalKey::NumpadMultiply, KeyLocation::Numpad)
+        }
+        "NumPadDivide" | "NumpadDivide" | "Divide" => {
+            return (PhysicalKey::NumpadDivide, KeyLocation::Numpad)
+        }
+        "NumPadDecimal" | "NumpadDecimal" | "Decimal" => {
+            return (PhysicalKey::NumpadDecimal, KeyLocation::Numpad)
+        }
+        "NumPadEnter" | "NumpadEnter" => return (PhysicalKey::NumpadEnter, KeyLocation::Numpad),
+        "Enter" | "Return" => PhysicalKey::Enter,
+        "Backspace" | "Back" => PhysicalKey::Backspace,
+        "Tab" => PhysicalKey::Tab,
+        "Space" => PhysicalKey::Space,
+        "Escape" => PhysicalKey::Escape,
+        "Delete" => PhysicalKey::Delete,
+        "Insert" => PhysicalKey::Insert,
+        "Home" => PhysicalKey::Home,
+        "End" => PhysicalKey::End,
+        "PageUp" | "Prior" => PhysicalKey::PageUp,
+        "PageDown" | "Next" => PhysicalKey::PageDown,
+        "ArrowLeft" | "Left" => PhysicalKey::ArrowLeft,
+        "ArrowRight" | "Right" => PhysicalKey::ArrowRight,
+        "ArrowUp" | "Up" => PhysicalKey::ArrowUp,
+        "ArrowDown" | "Down" => PhysicalKey::ArrowDown,
+        "ShiftLeft" | "LeftShift" => return (PhysicalKey::ShiftLeft, KeyLocation::Left),
+        "ShiftRight" | "RightShift" => return (PhysicalKey::ShiftRight, KeyLocation::Right),
+        "ControlLeft" | "LeftCtrl" => return (PhysicalKey::ControlLeft, KeyLocation::Left),
+        "ControlRight" | "RightCtrl" => return (PhysicalKey::ControlRight, KeyLocation::Right),
+        "AltLeft" | "LeftAlt" => return (PhysicalKey::AltLeft, KeyLocation::Left),
+        "AltRight" | "RightAlt" => return (PhysicalKey::AltRight, KeyLocation::Right),
+        "SuperLeft" | "MetaLeft" | "LWin" => return (PhysicalKey::SuperLeft, KeyLocation::Left),
+        "SuperRight" | "MetaRight" | "RWin" => return (PhysicalKey::SuperRight, KeyLocation::Right),
+        "CapsLock" | "Capital" => PhysicalKey::CapsLock,
+        "NumLock" => PhysicalKey::NumLock,
+        "ScrollLock" | "Scroll" => PhysicalKey::ScrollLock,
+        "Minus" | "OemMinus" => PhysicalKey::Minus,
+        "Equal" | "OemPlus" => PhysicalKey::Equal,
+        "BracketLeft" | "OemOpenBrackets" => PhysicalKey::BracketLeft,
+        "BracketRight" | "OemCloseBrackets" => PhysicalKey::BracketRight,
+        "Backslash" | "OemPipe" => PhysicalKey::Backslash,
+        "IntlBackslash" | "OemBackslash" => PhysicalKey::IntlBackslash,
+        "Semicolon" | "OemSemicolon" => PhysicalKey::Semicolon,
+        "Quote" | "OemQuotes" => PhysicalKey::Quote,
+        "Backquote" | "OemTilde" => PhysicalKey::Backquote,
+        "Comma" | "OemComma" => PhysicalKey::Comma,
+        "Period" | "OemPeriod" => PhysicalKey::Period,
+        "Slash" | "OemQuestion" => PhysicalKey::Slash,
+        "F1" => PhysicalKey::F1,
+        "F2" => PhysicalKey::F2,
+        "F3" => PhysicalKey::F3,
+        "F4" => PhysicalKey::F4,
+        "F5" => PhysicalKey::F5,
+        "F6" => PhysicalKey::F6,
+        "F7" => PhysicalKey::F7,
+        "F8" => PhysicalKey::F8,
+        "F9" => PhysicalKey::F9,
+        "F10" => PhysicalKey::F10,
+        "F11" => PhysicalKey::F11,
+        "F12" => PhysicalKey::F12,
+        _ => PhysicalKey::Unknown,
+    };
+    (key, KeyLocation::Standard)
+}
+
+fn parse_logical_key(physical: PhysicalKey, logical: &str, shift: bool) -> LogicalKey {
+    match logical {
+        "Enter" | "Return" | "NumPadEnter" => LogicalKey::Named(NamedKey::Enter),
+        "Backspace" | "Back" => LogicalKey::Named(NamedKey::Backspace),
+        "Tab" => LogicalKey::Named(NamedKey::Tab),
+        "Space" => LogicalKey::Character(' '),
+        "Escape" => LogicalKey::Named(NamedKey::Escape),
+        "Delete" => LogicalKey::Named(NamedKey::Delete),
+        "Insert" => LogicalKey::Named(NamedKey::Insert),
+        "Home" => LogicalKey::Named(NamedKey::Home),
+        "End" => LogicalKey::Named(NamedKey::End),
+        "PageUp" | "Prior" => LogicalKey::Named(NamedKey::PageUp),
+        "PageDown" | "Next" => LogicalKey::Named(NamedKey::PageDown),
+        "ArrowLeft" | "Left" => LogicalKey::Named(NamedKey::ArrowLeft),
+        "ArrowRight" | "Right" => LogicalKey::Named(NamedKey::ArrowRight),
+        "ArrowUp" | "Up" => LogicalKey::Named(NamedKey::ArrowUp),
+        "ArrowDown" | "Down" => LogicalKey::Named(NamedKey::ArrowDown),
+        "ShiftLeft" | "ShiftRight" | "LeftShift" | "RightShift" => {
+            LogicalKey::Named(NamedKey::Shift)
+        }
+        "ControlLeft" | "ControlRight" | "LeftCtrl" | "RightCtrl" => {
+            LogicalKey::Named(NamedKey::Control)
+        }
+        "AltLeft" | "AltRight" | "LeftAlt" | "RightAlt" => LogicalKey::Named(NamedKey::Alt),
+        "CapsLock" | "Capital" => LogicalKey::Named(NamedKey::CapsLock),
+        "NumLock" => LogicalKey::Named(NamedKey::NumLock),
+        "ScrollLock" | "Scroll" => LogicalKey::Named(NamedKey::ScrollLock),
+        "F1" => LogicalKey::Named(NamedKey::F1),
+        "F2" => LogicalKey::Named(NamedKey::F2),
+        "F3" => LogicalKey::Named(NamedKey::F3),
+        "F4" => LogicalKey::Named(NamedKey::F4),
+        "F5" => LogicalKey::Named(NamedKey::F5),
+        "F6" => LogicalKey::Named(NamedKey::F6),
+        "F7" => LogicalKey::Named(NamedKey::F7),
+        "F8" => LogicalKey::Named(NamedKey::F8),
+        "F9" => LogicalKey::Named(NamedKey::F9),
+        "F10" => LogicalKey::Named(NamedKey::F10),
+        "F11" => LogicalKey::Named(NamedKey::F11),
+        "F12" => LogicalKey::Named(NamedKey::F12),
+        s if s.chars().count() == 1 => {
+            let ch = s.chars().next().unwrap_or(' ');
+            LogicalKey::Character(ch)
+        }
+        _ => {
+            let _ = shift;
+            match physical {
+            PhysicalKey::Digit0 | PhysicalKey::Numpad0 => LogicalKey::Character('0'),
+            PhysicalKey::Digit1 | PhysicalKey::Numpad1 => LogicalKey::Character('1'),
+            PhysicalKey::Digit2 | PhysicalKey::Numpad2 => LogicalKey::Character('2'),
+            PhysicalKey::Digit3 | PhysicalKey::Numpad3 => LogicalKey::Character('3'),
+            PhysicalKey::Digit4 | PhysicalKey::Numpad4 => LogicalKey::Character('4'),
+            PhysicalKey::Digit5 | PhysicalKey::Numpad5 => LogicalKey::Character('5'),
+            PhysicalKey::Digit6 | PhysicalKey::Numpad6 => LogicalKey::Character('6'),
+            PhysicalKey::Digit7 | PhysicalKey::Numpad7 => LogicalKey::Character('7'),
+            PhysicalKey::Digit8 | PhysicalKey::Numpad8 => LogicalKey::Character('8'),
+            PhysicalKey::Digit9 | PhysicalKey::Numpad9 => LogicalKey::Character('9'),
+            PhysicalKey::Space => LogicalKey::Character(' '),
+            PhysicalKey::Enter | PhysicalKey::NumpadEnter => LogicalKey::Named(NamedKey::Enter),
+            _ => LogicalKey::Unknown,
+        }
+        }
+    }
+}
