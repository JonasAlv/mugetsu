index 00000000..842ec9df
--- /dev/null
+++ b/desktop/src/skua_ipc.rs
@@ -0,0 +1,674 @@
+//! Skua IPC bridge and X11 window embedding for VibeSkua on Linux.
+
+use crate::custom_event::RuffleEvent;
+use ruffle_core::PlayerEvent;
+use ruffle_core::context::UpdateContext;
+use ruffle_core::events::{
+    KeyDescriptor, KeyLocation, LogicalKey, NamedKey, PhysicalKey, TextControlCode,
+};
+use ruffle_core::external::{ExternalInterfaceProvider, Value as ExternalValue};
+use serde_json::{Value as JsonValue, json};
+use std::collections::BTreeMap;
+use std::io::{BufRead, BufReader, Write};
+use std::sync::{Mutex, OnceLock};
+use url::Url;
+use winit::event_loop::EventLoopProxy;
+
+#[cfg(unix)]
+use std::os::unix::net::UnixStream;
+
+static IPC_WRITER: OnceLock<Mutex<Box<dyn Write + Send>>> = OnceLock::new();
+
+pub enum SkuaIpcCommand {
+    Call {
+        id: u64,
+        name: String,
+        args: Vec<ExternalValue>,
+    },
+    Resize {
+        width: u32,
+        height: u32,
+    },
+    Focus {
+        focused: bool,
+    },
+    ClearKeys,
+    Key {
+        down: bool,
+        physical: String,
+        logical: String,
+        ctrl: bool,
+        shift: bool,
+        alt: bool,
+    },
+    Text {
+        text: String,
+    },
+    Headless {
+        on: bool,
+    },
+}
+
+static HEADLESS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn set_headless(on: bool) {
+    HEADLESS.store(on, std::sync::atomic::Ordering::Release);
+}
+
+pub fn headless() -> bool {
+    HEADLESS.load(std::sync::atomic::Ordering::Acquire)
+}
+
+pub fn is_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("MUGETSU_SKUA_SOCKET").is_some())
+}
+
+#[cfg(target_os = "linux")]
+pub fn parent_xid() -> Option<u32> {
+    std::env::var("MUGETSU_PARENT_XID")
+        .ok()
+        .and_then(|s| s.trim().parse::<u64>().ok())
+        .filter(|&id| id > 0)
+        .map(|id| id as u32)
+}
+
+fn send_json(val: &JsonValue) {
+    if let Some(writer_lock) = IPC_WRITER.get()
+        && let Ok(mut writer) = writer_lock.lock()
+    {
+        if let Ok(mut line) = serde_json::to_vec(val) {
+            line.push(b'\n');
+            let _ = writer.write_all(&line);
+            let _ = writer.flush();
+        }
+    }
+}
+
+pub fn notify_mouse_down() {
+    if is_enabled() {
+        send_json(&json!({
+            "type": "mouse_down",
+        }));
+    }
+}
+
+pub fn start(event_loop_proxy: EventLoopProxy<RuffleEvent>) {
+    let Ok(socket_path) = std::env::var("MUGETSU_SKUA_SOCKET") else {
+        return;
+    };
+
+    #[cfg(target_os = "linux")]
+    {
+        unsafe extern "C" {
+            fn prctl(
+                option: std::os::raw::c_int,
+                arg2: std::os::raw::c_ulong,
+                arg3: std::os::raw::c_ulong,
+                arg4: std::os::raw::c_ulong,
+                arg5: std::os::raw::c_ulong,
+            ) -> std::os::raw::c_int;
+        }
+        unsafe {
+            prctl(1, 9, 0, 0, 0);
+        }
+    }
+
+    #[cfg(unix)]
+    {
+        match UnixStream::connect(&socket_path) {
+            Ok(stream) => {
+                if let Ok(write_stream) = stream.try_clone() {
+                    let _ = IPC_WRITER.set(Mutex::new(Box::new(write_stream)));
+                }
+                std::thread::Builder::new()
+                    .name("skua-ipc-reader".to_string())
+                    .spawn(move || {
+                        let reader = BufReader::new(stream);
+                        for line in reader.lines() {
+                            let Ok(line) = line else {
+                                break;
+                            };
+                            if line.trim().is_empty() {
+                                continue;
+                            }
+                            let Ok(msg) = serde_json::from_str::<JsonValue>(&line) else {
+                                continue;
+                            };
+                            let cmd_type = msg.get("cmd").and_then(|v| v.as_str()).unwrap_or("");
+                            match cmd_type {
+                                "call" => {
+                                    let id = msg.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                                    let name = msg
+                                        .get("name")
+                                        .and_then(|v| v.as_str())
+                                        .unwrap_or("")
+                                        .to_string();
+                                    let args = msg
+                                        .get("args")
+                                        .and_then(|v| v.as_array())
+                                        .map(|arr| {
+                                            arr.iter()
+                                                .cloned()
+                                                .map(json_to_external)
+                                                .collect::<Vec<_>>()
+                                        })
+                                        .unwrap_or_default();
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Call { id, name, args },
+                                    ));
+                                }
+                                "resize" => {
+                                    let width =
+                                        msg.get("width").and_then(|v| v.as_u64()).unwrap_or(0)
+                                            as u32;
+                                    let height =
+                                        msg.get("height").and_then(|v| v.as_u64()).unwrap_or(0)
+                                            as u32;
+                                    if width > 0 && height > 0 {
+                                        let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                            SkuaIpcCommand::Resize { width, height },
+                                        ));
+                                    }
+                                }
+                                "focus" => {
+                                    let focused = msg
+                                        .get("focused")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(true);
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Focus { focused },
+                                    ));
+                                }
+                                "clear_keys" => {
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::ClearKeys,
+                                    ));
+                                }
+                                "key" => {
+                                    let down = msg
+                                        .get("down")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let physical = msg
+                                        .get("physical")
+                                        .and_then(|v| v.as_str())
+                                        .unwrap_or("")
+                                        .to_string();
+                                    let logical = msg
+                                        .get("logical")
+                                        .and_then(|v| v.as_str())
+                                        .unwrap_or("")
+                                        .to_string();
+                                    let ctrl = msg
+                                        .get("ctrl")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let shift = msg
+                                        .get("shift")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let alt = msg
+                                        .get("alt")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Key {
+                                            down,
+                                            physical,
+                                            logical,
+                                            ctrl,
+                                            shift,
+                                            alt,
+                                        },
+                                    ));
+                                }
+                                "text" => {
+                                    if let Some(text) = msg.get("text").and_then(|v| v.as_str()) {
+                                        let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                            SkuaIpcCommand::Text {
+                                                text: text.to_string(),
+                                            },
+                                        ));
+                                    }
+                                }
+                                "headless" => {
+                                    let on = msg
+                                        .get("on")
+                                        .and_then(|v| v.as_bool())
+                                        .unwrap_or(false);
+                                    let _ = event_loop_proxy.send_event(RuffleEvent::SkuaIpc(
+                                        SkuaIpcCommand::Headless { on },
+                                    ));
+                                }
+                                "quit" => {
+                                    std::process::exit(0);
+                                }
+                                _ => {}
+                            }
+                        }
+                        std::process::exit(0);
+                    })
+                    .ok();
+            }
+            Err(err) => {
+                tracing::error!("Failed to connect to Skua IPC socket {socket_path}: {err}");
+            }
+        }
+    }
+}
+
+pub fn handle_key_event(
+    player: &mut crate::player::PlayerController,
+    down: bool,
+    physical: &str,
+    logical: &str,
+    ctrl: bool,
+    shift: bool,
+    alt: bool,
+) {
+    let mut phys_loc = parse_physical_key(physical);
+    if phys_loc.0 == PhysicalKey::Unknown {
+        phys_loc = parse_physical_key(logical);
+    }
+    let (physical_key, key_location) = phys_loc;
+    let logical_key = parse_logical_key(physical_key, logical, shift);
+    let key = KeyDescriptor {
+        physical_key,
+        logical_key,
+        key_location,
+    };
+
+    if down {
+        player.handle_event(PlayerEvent::KeyDown { key });
+        if let Some(code) = map_text_control(&logical_key, ctrl, shift) {
+            player.handle_event(PlayerEvent::TextControl { code });
+        } else if !ctrl
+            && !alt
+            && let LogicalKey::Character(codepoint) = logical_key
+            && !codepoint.is_control()
+        {
+            player.handle_event(PlayerEvent::TextInput { codepoint });
+        }
+    } else {
+        player.handle_event(PlayerEvent::KeyUp { key });
+    }
+}
+
+fn map_text_control(logical_key: &LogicalKey, ctrl: bool, shift: bool) -> Option<TextControlCode> {
+    match *logical_key {
+        LogicalKey::Named(NamedKey::Enter) => Some(TextControlCode::Enter),
+        LogicalKey::Character('a' | 'A') if ctrl => Some(TextControlCode::SelectAll),
+        LogicalKey::Character('c' | 'C') if ctrl => Some(TextControlCode::Copy),
+        LogicalKey::Character('v' | 'V') if ctrl => Some(TextControlCode::Paste),
+        LogicalKey::Character('x' | 'X') if ctrl => Some(TextControlCode::Cut),
+        LogicalKey::Named(NamedKey::Backspace) if ctrl => Some(TextControlCode::BackspaceWord),
+        LogicalKey::Named(NamedKey::Backspace) => Some(TextControlCode::Backspace),
+        LogicalKey::Named(NamedKey::Delete) if ctrl => Some(TextControlCode::DeleteWord),
+        LogicalKey::Named(NamedKey::Delete) => Some(TextControlCode::Delete),
+        LogicalKey::Named(NamedKey::ArrowLeft) if ctrl && shift => {
+            Some(TextControlCode::SelectLeftWord)
+        }
+        LogicalKey::Named(NamedKey::ArrowLeft) if ctrl => Some(TextControlCode::MoveLeftWord),
+        LogicalKey::Named(NamedKey::ArrowLeft) if shift => Some(TextControlCode::SelectLeft),
+        LogicalKey::Named(NamedKey::ArrowLeft) => Some(TextControlCode::MoveLeft),
+        LogicalKey::Named(NamedKey::ArrowRight) if ctrl && shift => {
+            Some(TextControlCode::SelectRightWord)
+        }
+        LogicalKey::Named(NamedKey::ArrowRight) if ctrl => Some(TextControlCode::MoveRightWord),
+        LogicalKey::Named(NamedKey::ArrowRight) if shift => Some(TextControlCode::SelectRight),
+        LogicalKey::Named(NamedKey::ArrowRight) => Some(TextControlCode::MoveRight),
+        LogicalKey::Named(NamedKey::Home) if ctrl && shift => {
+            Some(TextControlCode::SelectLeftDocument)
+        }
+        LogicalKey::Named(NamedKey::Home) if ctrl => Some(TextControlCode::MoveLeftDocument),
+        LogicalKey::Named(NamedKey::Home) if shift => Some(TextControlCode::SelectLeftLine),
+        LogicalKey::Named(NamedKey::Home) => Some(TextControlCode::MoveLeftLine),
+        LogicalKey::Named(NamedKey::End) if ctrl && shift => {
+            Some(TextControlCode::SelectRightDocument)
+        }
+        LogicalKey::Named(NamedKey::End) if ctrl => Some(TextControlCode::MoveRightDocument),
+        LogicalKey::Named(NamedKey::End) if shift => Some(TextControlCode::SelectRightLine),
+        LogicalKey::Named(NamedKey::End) => Some(TextControlCode::MoveRightLine),
+        _ => None,
+    }
+}
