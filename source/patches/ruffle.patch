+        else {
+            pc::inc(pc::ATLAS_FULL);
+            return None;
+        };
+        if !is_leaf(commands) {
+            pc::inc(pc::ATLAS_NESTED);
+            return None;
+        }
+        let rect = if matches!(blend_type, BlendType::Complex(_)) {
+            rounded
+        } else {
+            exact
+        };
+        if rect.width > ATLAS_PAGE_WIDTH || rect.height > ATLAS_PAGE_MAX_HEIGHT {
+            pc::inc(pc::ATLAS_TOO_BIG);
+            return None;
+        }
+        Some(AtlasCandidate {
+            rect,
+            blend_type,
+            counter,
+        })
+    }
