+//! Small policies kept independent of the window and GPU for deterministic checks.
+use std::sync::OnceLock;
+
+pub fn should_draw(minimized: bool, occluded: bool, headless: bool) -> bool {
+    !minimized && !occluded && !headless
+}
+
+pub fn headless_budget() -> Option<u64> {
+    std::env::var("SKUA_HEADLESS_POOL_IDLE_MB").ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|&mb| mb <= 4096).map(|mb| mb << 20)
+}
+
+pub fn details_enabled() -> bool {
+    static DETAILS: OnceLock<bool> = OnceLock::new();
+    *DETAILS.get_or_init(|| std::env::var("SKUA_PERF_DETAILS").as_deref() == Ok("1"))
+}
+
+#[derive(Default)]
+pub struct FrameSamples(Vec<f64>);
+impl FrameSamples {
+    pub fn record(&mut self, ms: f64) {
+        if details_enabled() { self.record_sample(ms); }
+    }
+    fn record_sample(&mut self, ms: f64) {
+        if self.0.len() < 4096 && ms.is_finite() && ms >= 0.0 { self.0.push(ms); }
+    }
+    pub fn percentile(&mut self, percent: usize) -> f64 {
+        if self.0.is_empty() { return 0.0; }
+        self.0.sort_unstable_by(f64::total_cmp);
+        let rank = (self.0.len() * percent.clamp(1, 100)).div_ceil(100);
+        self.0[rank - 1]
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn headless_never_requests_draws_and_restore_does() {
+        for minimized in [false, true] { for occluded in [false, true] {
+            assert!(!should_draw(minimized, occluded, true));
+        }}
+        assert!(should_draw(false, false, false));
+        assert!(!should_draw(true, false, false));
+        assert!(!should_draw(false, true, false));
+    }
+    #[test]
+    fn samples_are_bounded_and_percentiles_retain_slow_frames() {
+        let mut samples=FrameSamples::default();
+        for i in 1..=100 { samples.record_sample(i as f64); }
+        samples.record_sample(f64::NAN);
+        assert_eq!(samples.percentile(95),95.0);
+        assert_eq!(samples.percentile(99),99.0);
+        for _ in 0..10000 { samples.record_sample(1.0); }
+        assert_eq!(samples.0.len(),4096);
+        assert_eq!(FrameSamples::default().percentile(99),0.0);
+    }
+}
