+    /// AQW build: inserts the movies (as `Arc::as_ptr` addresses) whose `LoaderInfo` or code is
+    /// still reachable. Only valid during finalization.
+    pub fn movie_anchors(
+        &self,
+        fc: &gc_arena::Finalization<'gc>,
