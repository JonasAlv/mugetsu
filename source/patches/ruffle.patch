+    fn intel_graphics_on_this_pc() {
+        for low_power in [false, true] {
+            let start = std::time::Instant::now();
+            let result = super::intel_graphics(low_power);
+            println!(
+                "low_power={low_power}: {result:?} ({:.1} ms)",
+                start.elapsed().as_secs_f64() * 1000.0
+            );
+        }
+    }
+}
