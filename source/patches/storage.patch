     [API("661")]
     public class FileStream extends EventDispatcher {
+        private var _file:File = null;
+        private var _mode:String = "read";
+        private var _buffer:String = "";
+        private var _position:uint = 0;
+
         public function FileStream() {
             super();
         }
 
+        public function open(file:File, fileMode:String):void {
+            this._file = file;
+            this._mode = (fileMode != null) ? fileMode.toLowerCase() : "read";
+            if (this._mode == "read" || this._mode == "update") {
+                if (file != null && file.exists) {
+                    this._buffer = File.fsReadFile(file.nativePath);
+                } else {
+                    this._buffer = "";
+                }
+                this._position = 0;
+            } else if (this._mode == "append") {
+                this._buffer = "";
+                this._position = 0;
+            } else {
+                // "write"
+                this._buffer = "";
+                this._position = 0;
+            }
+        }
+
+        public function openAsync(file:File, fileMode:String):void {
+            this.open(file, fileMode);
+        }
+
+        public function get bytesAvailable():uint {
+            if (this._buffer == null) return 0;
+            if (this._position >= this._buffer.length) return 0;
+            return this._buffer.length - this._position;
+        }
+
+        public function get position():uint {
+            return this._position;
+        }
+
+        public function set position(value:uint):void {
+            this._position = value;
+        }
+
+        public function readUTFBytes(length:uint):String {
+            if (this._buffer == null || this._position >= this._buffer.length) {
+                return "";
+            }
+            var avail:uint = this._buffer.length - this._position;
+            var toRead:uint = (length < avail) ? length : avail;
+            var chunk:String = this._buffer.substr(this._position, toRead);
+            this._position += chunk.length;
+            return chunk;
+        }
+
+        public function writeUTFBytes(value:String):void {
+            if (value != null && value.length > 0) {
+                if (this._mode == "append") {
+                    if (this._file != null) {
+                        File.fsWriteFile(this._file.nativePath, value, true);
+                    }
+                } else {
+                    this._buffer += value;
+                }
+            }
+        }
+
+        public function writeBytes(bytes:*, offset:uint = 0, length:uint = 0):void {
+            if (bytes != null) {
+                var s:String = bytes.toString();
+                writeUTFBytes(s);
+            }
+        }
+
         public function close():void {
-            stub_method("flash.filesystem.FileStream", "close");
+            if (this._file != null && this._buffer != null) {
+                if (this._mode == "write" || this._mode == "update") {
+                    File.fsWriteFile(this._file.nativePath, this._buffer, false);
+                }
+            }
+            this._file = null;
+            this._buffer = "";
+            this._position = 0;
         }
     }
 }
