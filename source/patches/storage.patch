@@ -0,0 +1,228 @@
+//! `flash.filesystem.File` native methods
+
+use crate::avm2::array::ArrayStorage;
+use crate::avm2::function::FunctionArgs;
+use crate::avm2::object::ArrayObject;
+use crate::avm2::parameters::ParametersExt;
+use crate::avm2::{Activation, AvmString, Error, Value};
+use std::fs;
+use std::path::{Path, PathBuf};
+
+fn get_storage_root() -> PathBuf {
+    if let Ok(dir) = std::env::var("AQW_STORAGE_DIR") {
+        if !dir.is_empty() {
+            return PathBuf::from(dir);
+        }
+    }
+    if let Ok(config_home) = std::env::var("XDG_CONFIG_HOME") {
+        if !config_home.is_empty() {
+            return PathBuf::from(config_home).join("aqw-mugetsu");
+        }
+    }
+    if let Ok(home) = std::env::var("HOME") {
+        if !home.is_empty() {
+            return PathBuf::from(home).join(".config").join("aqw-mugetsu");
+        }
+    }
+    if let Ok(appdata) = std::env::var("APPDATA") {
+        if !appdata.is_empty() {
+            return PathBuf::from(appdata).join("aqw-mugetsu");
+        }
+    }
+    PathBuf::from("./aqw-mugetsu")
+}
+
+pub fn get_app_storage_dir<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    _args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let p = get_storage_root();
+    let s = p.to_string_lossy().to_string();
+    Ok(AvmString::new_utf8(activation.gc(), s).into())
+}
+
+pub fn get_app_dir<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    _args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let cur = std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."));
+    let s = cur.to_string_lossy().to_string();
+    Ok(AvmString::new_utf8(activation.gc(), s).into())
+}
+
+pub fn get_documents_dir<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    _args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let mut p = PathBuf::from(".");
+    if let Ok(home) = std::env::var("HOME") {
+        let doc = PathBuf::from(&home).join("Documents");
+        if doc.exists() {
+            p = doc;
+        } else {
+            p = PathBuf::from(home);
+        }
+    } else if let Ok(userprofile) = std::env::var("USERPROFILE") {
+        let doc = PathBuf::from(&userprofile).join("Documents");
+        if doc.exists() {
+            p = doc;
+        } else {
+            p = PathBuf::from(userprofile);
+        }
+    }
+    Ok(AvmString::new_utf8(activation.gc(), p.to_string_lossy().to_string()).into())
+}
+
+pub fn get_user_dir<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    _args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let home = std::env::var("HOME")
+        .or_else(|_| std::env::var("USERPROFILE"))
+        .unwrap_or_else(|_| ".".to_string());
+    Ok(AvmString::new_utf8(activation.gc(), home).into())
+}
+
+pub fn fs_exists<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let exists = Path::new(path_str.as_ref()).exists();
+    Ok(Value::Bool(exists))
+}
+
+pub fn fs_is_directory<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let is_dir = Path::new(path_str.as_ref()).is_dir();
+    Ok(Value::Bool(is_dir))
+}
+
+pub fn fs_create_directory<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let _ = fs::create_dir_all(path_str.as_ref());
+    Ok(Value::Undefined)
+}
+
+pub fn fs_delete_file<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let _ = fs::remove_file(path_str.as_ref());
+    Ok(Value::Undefined)
+}
+
+pub fn fs_delete_directory<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let recursive = args.get_bool(1);
+    if recursive {
+        let _ = fs::remove_dir_all(path_str.as_ref());
+    } else {
+        let _ = fs::remove_dir(path_str.as_ref());
+    }
+    Ok(Value::Undefined)
+}
+
+pub fn fs_move_file<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let src = args.get_string_non_null(activation, 0, "source")?;
+    let dst = args.get_string_non_null(activation, 1, "dest")?;
+    let src_str = src.to_utf8_lossy();
+    let dst_str = dst.to_utf8_lossy();
+    let _ = fs::rename(src_str.as_ref(), dst_str.as_ref());
+    Ok(Value::Undefined)
+}
+
+pub fn fs_list_directory<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let p = Path::new(path_str.as_ref());
+
+    let mut names: Vec<Value<'gc>> = Vec::new();
+    if let Ok(entries) = fs::read_dir(p) {
+        for entry in entries.flatten() {
+            if let Ok(file_name) = entry.file_name().into_string() {
+                let avm_s = AvmString::new_utf8(activation.gc(), file_name);
+                names.push(avm_s.into());
+            }
+        }
+    }
+
+    let storage = ArrayStorage::from_iter(names);
+    Ok(ArrayObject::from_storage(activation.context, storage).into())
+}
+
+pub fn fs_read_file<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let path_str = path.to_utf8_lossy();
+    let content = fs::read_to_string(path_str.as_ref()).unwrap_or_default();
+    Ok(AvmString::new_utf8(activation.gc(), content).into())
+}
+
+pub fn fs_write_file<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Value<'gc>,
+    args: FunctionArgs<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    use std::io::Write;
+    let path = args.get_string_non_null(activation, 0, "path")?;
+    let content = args.get_string_non_null(activation, 1, "content")?;
+    let append = args.get_bool(2);
+
+    let path_str = path.to_utf8_lossy();
+    let content_str = content.to_utf8_lossy();
+
+    let p = Path::new(path_str.as_ref());
+    if let Some(parent) = p.parent() {
+        let _ = fs::create_dir_all(parent);
+    }
+
+    let mut opts = fs::OpenOptions::new();
+    opts.create(true).write(true);
+    if append {
+        opts.append(true);
+    } else {
+        opts.truncate(true);
+    }
+
+    if let Ok(mut file) = opts.open(p) {
+        let _ = file.write_all(content_str.as_bytes());
+    }
+
+    Ok(Value::Undefined)
+}
